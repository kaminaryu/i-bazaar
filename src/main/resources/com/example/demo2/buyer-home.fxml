<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane prefHeight="700.0" prefWidth="400.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.demo2.BuyerHomeController">

</AnchorPane>
<!--
  buyer-home.fxml — The main buyer screen.

  Structure:
    [Header bar]
    [ScrollPane → GridPane]   ← product cards go here (built in controller)
    [Bottom nav bar]
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo2.BuyerHomeController"
      prefWidth="400" prefHeight="700"
      style="-fx-background-color: #7B2D8B;">

    <!-- ═══ HEADER ═══════════════════════════════════════════════════ -->
    <HBox style="-fx-background-color: #1A1A2E; -fx-padding: 16 20 16 20;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text="i-Bazaar"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <!-- Region with HGrow=ALWAYS pushes the greeting to the right -->
        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="greetingLabel"
               style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.6);"/>
    </HBox>

    <!-- ═══ PRODUCT GRID ═════════════════════════════════════════════ -->
    <!--
      ScrollPane wraps the grid so it's scrollable when there are many products.
      fitToWidth=true makes the content stretch to fill the scroll pane width.
      The transparent styles hide the ugly default ScrollPane border/background.
    -->
    <ScrollPane VBox.vgrow="ALWAYS"
                fitToWidth="true"
                style="-fx-background: #7B2D8B;
                       -fx-background-color: #7B2D8B;
                       -fx-border-color: transparent;">

        <!-- The GridPane is filled programmatically in BuyerHomeController.loadProductGrid() -->
        <GridPane fx:id="productGrid"/>

    </ScrollPane>

    <!-- ═══ BOTTOM NAV ════════════════════════════════════════════════ -->
    <HBox style="-fx-background-color: #1A1A2E; -fx-padding: 10 0;"
          alignment="CENTER">
        <!-- Each button takes equal 1/3 width via HGrow=ALWAYS + maxWidth=Infinity -->
        <Button text="🏠  Home"    styleClass="nav-btn"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="🛒  Cart"    styleClass="nav-btn" onAction="#showCart"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="🚪  Logout"  styleClass="nav-btn" onAction="#handleLogout"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

</VBox>
